# ============================================
# CV Intelligence System - Environment Template
# ============================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to Git!

# --- LLM Provider ---
# Options: gemini, openai, anthropic, groq, ollama
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# --- Groq API (if using groq provider) ---
# FREE: 6,000 requests/day, 30 requests/minute
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# --- Google Gemini API (if using gemini provider) ---
GOOGLE_API_KEY=your-google-api-key-here

# --- OpenAI API (if using openai provider) ---
OPENAI_API_KEY=your-openai-api-key-here

# --- Supabase Database ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key-here

# --- Flask ---
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-string
